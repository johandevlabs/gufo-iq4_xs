From 67b276c29aba61df0cf397460a1556a780036a17 Mon Sep 17 00:00:00 2001
From: Sami Slimani <slimsamister@gmail.com>
Date: Thu, 5 Nov 2026 22:05:39 +0100
Subject: [PATCH 1/3] port: routed-expert fields in the extension's own
 ModelConfig

Strycast added expert_count, expert_used_count, expert_ff_length,
expert_shared_ff_length and IsMoE() to Gufo's core ModelConfig. An external
extension cannot change core, so strycast::core::ModelConfig extends Gufo's
struct with them; the copy names it as core::ModelConfig.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 q35/family/config/model_config.hpp | 26 ++++++++++++++++++++++++++
 q35/family/config/qwen_config.hpp  |  2 +-
 q35/model/continuation_layout.hpp  |  2 +-
 q35/model/hip/executor.hpp         |  2 +-
 q35/model/modules/module_ctx.hpp   |  2 +-
 q35/model/ssm.hpp                  |  2 +-
 q35/model/state.hpp                |  2 +-
 q35/ns.hpp                         |  4 ++++
 8 files changed, 36 insertions(+), 6 deletions(-)
 create mode 100644 q35/family/config/model_config.hpp

diff --git a/q35/family/config/model_config.hpp b/q35/family/config/model_config.hpp
new file mode 100644
index 0000000..5e5a54d
--- /dev/null
+++ b/q35/family/config/model_config.hpp
@@ -0,0 +1,26 @@
+#pragma once
+
+#include "q35/ns.hpp"
+
+#include <cstdint>
+
+#include <gufo/ext/model_config.hpp>
+
+namespace strycast::core {
+
+/// Gufo's ModelConfig plus the routed-expert shape of qwen35moe targets. The
+/// copy names this type as core::ModelConfig, so it replaces Gufo's within the
+/// extension and still binds wherever the public API takes Gufo's.
+struct ModelConfig : ::gufo::core::ModelConfig {
+  // MoE (qwen35moe): zero expert_count denotes a dense FFN model.
+  std::uint32_t expert_count{0};
+  std::uint32_t expert_used_count{0};
+  std::uint32_t expert_ff_length{0};
+  std::uint32_t expert_shared_ff_length{0};
+
+  [[nodiscard]] constexpr bool IsMoE() const noexcept {
+    return expert_count > 0;
+  }
+};
+
+}  // namespace strycast::core
