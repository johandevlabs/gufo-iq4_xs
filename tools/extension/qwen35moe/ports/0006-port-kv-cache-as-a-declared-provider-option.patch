From c8825dc2a58025adc48b62fdb589ac82b59e57ab Mon Sep 17 00:00:00 2001
From: Sami Slimani <slimsamister@gmail.com>
Date: Sun, 8 Nov 2026 09:15:16 +0100
Subject: [PATCH 6/6] port: --kv-cache as a declared provider option

Gufo delivers options an extension declares in TextRunnerOptions::
provider_options (ext API 0.2, gufo#1046); Strycast's core field
TextRunnerOptions::kv_cache does not exist there.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 q35/model/runner.cpp | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/q35/model/runner.cpp b/q35/model/runner.cpp
index 6d0a437..91d84f1 100644
--- a/q35/model/runner.cpp
+++ b/q35/model/runner.cpp
@@ -1209,13 +1209,16 @@ std::shared_ptr<ext::TextModelRunner> CreateQwenTextRunner(
     }
     reader = std::shared_ptr<const core::GgufReader>(std::move(reader_owner));
   }
-  if (!options.kv_cache.empty() && options.kv_cache != "f16" &&
-      options.kv_cache != "q8_0") {
+  // Declared in extension.json; Gufo delivers it only when given.
+  const auto* kv_option =
+      ext::FindOption<std::string>(options.provider_options, "--kv-cache");
+  const std::string kv_cache = kv_option != nullptr ? *kv_option : "";
+  if (!kv_cache.empty() && kv_cache != "f16" && kv_cache != "q8_0") {
     if (error)
       *error = "--kv-cache must be f16 or q8_0";
     return nullptr;
   }
-  const auto kv_storage = options.kv_cache == "q8_0"
+  const auto kv_storage = kv_cache == "q8_0"
                               ? hip::QwenKvCacheStorage::kQ8
                               : hip::QwenKvCacheStorage::kFp16;
   std::shared_ptr<models::qwen::vision::Encoder> vision;
