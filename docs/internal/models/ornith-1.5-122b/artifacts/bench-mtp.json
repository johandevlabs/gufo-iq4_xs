{
  "schema": "gufo-model-bench/1",
  "category": "llm",
  "model": {
    "id": "Ornith-1.5-122B",
    "docs": "ornith-1.5-122b",
    "label": "Ornith 122B"
  },
  "files": {
    "gguf": "Ornith 1.5 122B Q4_K_M GGUF (carries its MTP layer)"
  },
  "variants": {
    "q4km": {
      "label": "Q4_K_M",
      "requires": [
        "gguf"
      ]
    }
  },
  "sampling": {
    "temperature": 0,
    "seed": 1
  },
  "gufo": {
    "serve": [],
    "llm": [
      "--think",
      "off",
      "--max-pending-per-client",
      "8",
      "--prefill-chunk",
      "2048",
      "--prefill-decode-rounds",
      "8"
    ],
    "readiness": "/ready"
  },
  "reference": {
    "name": "llama.cpp",
    "server": "llama-server",
    "args": [
      "-ngl",
      "999",
      "-fa",
      "on",
      "--cache-reuse",
      "0",
      "--jinja",
      "--reasoning",
      "off",
      "--cache-ram",
      "0"
    ],
    "endpoint_profile": "openai",
    "readiness": "/health"
  },
  "speculative": {
    "mode": "mtp",
    "label": "MTP",
    "gufo_args": [
      "--speculative",
      "mtp",
      "--mtp-model",
      "{gguf}",
      "--draft-tokens",
      "2"
    ],
    "reference": {
      "args": [
        "--spec-type",
        "draft-mtp",
        "--spec-draft-model",
        "{gguf}",
        "--spec-draft-ngl",
        "999"
      ]
    }
  },
  "tables": {
    "single-mtp": {
      "title": "Single user, MTP",
      "per_variant": true,
      "speculative": true,
      "prompt_tokens": 2048,
      "output_tokens": 128,
      "depths": [
        0,
        4096,
        8192,
        16384,
        32768,
        65536
      ],
      "context": 67840,
      "depth_tolerance": 0.005,
      "prefix": {
        "generator": "synthetic-paragraphs",
        "seed": 1
      },
      "repetitions": 1,
      "metric": "tok/s",
      "better": "higher",
      "workloads": {
        "single-mtp": {
          "label": "mixed",
          "workload": "prose"
        },
        "single-mtp-repetition": {
          "label": "repetitive",
          "workload": "repetition"
        }
      }
    }
  }
}
