  },
  "speculative": {
    "mode": "mtp",
    "label": "MTP",
    "gufo_args": [
      "--speculative",
      "mtp",
      "--mtp-model",
      "{gguf}",
      "--draft-tokens",
      "2"
    ]
  },
  "tables": {
    "single-ar": {
      "title": "Single user, autoregressive",
      "per_variant": true,
      "prompt_tokens": 2048,
