      "context": 67840,
      "depth_tolerance": 0.005,
      "prefix": {
        "generator": "synthetic-paragraphs",
        "seed": 1
      },
      "repetitions": 1,
      "metric": "tok/s",
      "better": "higher"
    },
    "loading": {
      "title": "Loading time",
      "per_variant": false,
      "context": 67840,
      "sessions": 1,
      "repetitions": 1,
      "metric": "seconds",
      "better": "lower",
      "rows": "variants"
    },
    "memory": {
      "title": "Memory occupation",
      "per_variant": true,
      "context": 67840,
      "workloads": [
        {
          "id": "pp2048 + tg128",
          "depth": 0,
          "prompt_tokens": 2048,
          "output_tokens": 128
        },
        {
          "id": "16K prefix, pp4096 + tg128",
          "depth": 16384,
          "prompt_tokens": 4096,
          "output_tokens": 128
        }
      ],
      "metric": "GiB",
      "better": "lower",
      "mode": "ar"
