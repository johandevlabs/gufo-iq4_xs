{
  "schema": 1,
  "name": "qwen",
  "version": "0.1.0",
  "api_version": ">= 0.2.0",
  "entry": "qwen_register",
  "registration_target": "gufo_qwen",
  "depends": [
    "qwen38_flash_next"
  ],
  "platforms": [
    "linux",
    "windows"
  ],
  "providers": [
    {
      "id": "qwen27-q4",
      "capability": "text_generation",
      "keys": [
        "gguf:qwen27",
        "gguf:qwen35moe"
      ],
      "model_ids": [
        "qwen27"
      ],
      "speculative": [
        "dflash2",
        "mtp"
      ],
      "target": "gufo_qwen_hip",
      "entry": "qwen_provider_register",
      "serving": {
        "draft_options": {
          "dflash2": "--dflash-model",
          "mtp": "--mtp-model"
        }
      }
    }
  ],
  "options": [
    {
      "name": "--dflash-model",
      "type": "path",
      "commands": [
        "serve",
        "bench",
        "prompt"
      ],
      "providers": [
        "qwen27-q4"
      ],
      "help": "DFlash2 draft model path for speculative decoding"
    },
    {
      "name": "--mtp-model",
      "type": "path",
      "commands": [
        "serve",
        "bench",
        "prompt"
      ],
      "providers": [
        "qwen27-q4"
      ],
      "help": "MTP draft model path for speculative decoding"
    }
  ],
  "targets": {
    "gufo_qwen": {
      "requires": []
    },
    "gufo_qwen_hip": {
      "requires": [
        "hip"
      ]
    }
  },
  "production_paths": {
    "include": [
      "**/*.cpp",
      "**/*.h",
      "**/*.hpp",
      "**/*.hip",
      "extension.*"
    ],
    "exclude": [
      "tests/",
      "functional/",
      "tools/",
      "fixtures/"
    ]
  },
  "docs": {
    "title": "Qwen3.8 27B",
    "inputs": "Q4/Q8 GGUF; text/images",
    "guide": "docs/models/qwen3.8-27b.md"
  },
  "tests": [
    {
      "target": "qwen_tokenizer_test",
      "ctest": "qwen_tokenizer_test",
      "check_pr": true,
      "windows_build": true
    },
    {
      "target": "qwen_chat_template_test",
      "ctest": "qwen_chat_template_test",
      "check_pr": true,
      "windows_build": true
    },
    {
      "target": "qwen27b_continuation_identity_test",
      "ctest": "qwen27b_continuation_identity_test",
      "check_pr": true,
      "windows_build": true
    },
    {
      "target": "qwen27b_continuation_layout_test",
      "ctest": "qwen27b_continuation_layout_test",
      "check_pr": true,
      "windows_build": true
    }
  ],
  "test_labels": [
    "qwen27b"
  ],
  "fixtures": "tests/models/qwen27b/fixtures/",
  "functional": "functional/"
}
